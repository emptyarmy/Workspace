# AI_TPI – Konfiguration für den Betrieb mit docker-compose.prod.yml (Phase 8c).
# Kopieren nach .env.production und ausfüllen. .env.production NIE ins Repository einchecken.
# Ausführlich: docs/06_betrieb/02_konfiguration.md und Starlight „Referenz → Konfiguration“.

# Öffentliche Adresse (HTTPS, über den Reverse Proxy) – für Links in E-Mails
PUBLIC_BASE_URL=https://tpi.example.com

# Datenbank (Container „db“)
POSTGRES_USER=ai_tpi
POSTGRES_DB=ai_tpi
# Langes Zufallspasswort ohne Sonderzeichen (steht in der Datenbank-URL), z. B.: openssl rand -hex 32
POSTGRES_PASSWORD=

# Schlüssel für SMTP-Passwort und KI-API-Schlüssel in der Datenbank (mind. 32 Zeichen).
# Erzeugen: openssl rand -base64 48 – sicher aufbewahren: ohne ihn sind gespeicherte Geheimnisse verloren.
SECRET_ENCRYPTION_KEY=

# E-Mail-Versand (Benutzer und Passwort des SMTP-Servers pflegt der Admin in der Oberfläche)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
MAIL_FROM=AI_TPI <no-reply@example.com>

# Port auf dem Host (nur 127.0.0.1) – Ziel des Reverse Proxys
APP_PORT=3000
# Hinter dem Reverse Proxy: Client-Adresse aus X-Forwarded-For (Rate-Limits, Audit-Log)
TRUST_PROXY=true
# Sitzungs-Cookie nur über HTTPS (nur für einen Test ohne HTTPS auf false setzen)
COOKIE_SECURE=true
# Nach der Ersteinrichtung auf false setzen
SETUP_ENABLED=true

LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MIN=30
RESET_MAILS_PER_15_MIN=3

# Optional: eigene Images (z. B. aus einem Firmen-Spiegel)
# NODE_IMAGE=node:22-bookworm-slim
# POSTGRES_IMAGE=postgres:16-alpine
# APP_IMAGE=ai-tpi:latest
