{
  "name": "@ai-tpi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:reset:e2e": "tsx scripts/reset-e2e-db.ts"
  },
  "dependencies": {
    "@ai-tpi/catalog": "*",
    "@ai-tpi/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.0",
    "typescript-eslint": "^7.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0"
  }
}
