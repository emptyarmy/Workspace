{
  "name": "qcad-mcp",
  "version": "0.1.0",
  "description": "MCP server that creates 2D CAD drawings (DXF/DWG) with QCAD",
  "type": "module",
  "bin": {
    "qcad-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "qcad"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
