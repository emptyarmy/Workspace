# Kopieren nach .env und anpassen. .env niemals einchecken.

# --- Server ---
SERVER_HOST=127.0.0.1
# Port des API-Servers (gilt auch für den Proxy der Weboberfläche). 3001 statt 3000, weil 3000 oft von anderen
# Anwendungen belegt ist. Ist auch 3001 belegt, einen anderen freien Port eintragen.
SERVER_PORT=3001
NODE_ENV=development

# PostgreSQL (lokal per `docker compose up -d db`; der Container ist in docker-compose.yml auf Port 5433 gelegt,
# weil auf 5432 oft ein lokal installiertes PostgreSQL läuft)
DATABASE_URL=postgres://ai_tpi:ai_tpi@localhost:5433/ai_tpi

# Ersteinrichtung des ersten Admins nur direkt über localhost (R-06), nicht über einen Proxy.
# Nach der Einrichtung auf false setzen.
SETUP_ENABLED=true

# Schlüssel zum Verschlüsseln von KI-API-Schlüsseln und SMTP-Passwörtern in der DB (mind. 32 Zeichen).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leer = fester Entwicklungsschlüssel (nur development/test); in production Pflicht.
SECRET_ENCRYPTION_KEY=

# Standard-Mailversand (je Firma im Admin-Bereich überschreibbar)
# sendmail = Mailversand des Betriebssystems; smtp = SMTP-Server (lokal: Mailpit)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@ai-tpi.local

# --- Web ---
WEB_PORT=5173

# Basis-URL der Weboberfläche für Links in E-Mails (Einladung, Einmal-Link)
PUBLIC_BASE_URL=http://localhost:5173
# Sitzungs-Cookie nur über HTTPS senden. Ohne Angabe: production true, sonst false.
COOKIE_SECURE=false

# Hinter einem Reverse Proxy (nginx, Traefik …) auf true setzen: Client-Adresse aus X-Forwarded-For.
TRUST_PROXY=false
# Protokollstufe (JSON auf stdout): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Anfragen je Minute und Client-Adresse an Anmeldung/Passwort-Funktionen (0 = aus)
AUTH_RATE_LIMIT_PER_MIN=30
# „Passwort vergessen“-Mails je Adresse in 15 Minuten (0 = aus)
RESET_MAILS_PER_15_MIN=3
